filters:
  and:
    - file.ext == "md"
    - file.hasProperty("citekey")
formulas:
  main_plant: |
    if(file.hasTag("Plant/Lettuce"), "Lettuce",
    if(file.hasTag("Plant/Tomato"), "Tomato",
    if(file.hasTag("Plant/Basil"), "Basil",
    if(file.hasTag("Plant/Cucumber"), "Cucumber",
    if(file.hasTag("Plant/Pak-Choi"), "Pak Choi",
    if(file.hasTag("Plant/Parsley"), "Parsley",
    if(file.hasTag("Plant/Rocket"), "Rocket",
    if(file.hasTag("Plant/Swiss-Chard"), "Swiss Chard",
    if(file.hasTag("Plant/Watercress"), "Watercress",
    "Other / multiple")))))))))
  main_fish: |
    if(file.hasTag("Fish/Tilapia"), "Tilapia",
    if(file.hasTag("Fish/Koi"), "Koi",
    if(file.hasTag("Fish/African-Catfish"), "African Catfish",
    if(file.hasTag("Fish/African-catfish"), "African Catfish",
    if(file.hasTag("Fish/Trout"), "Trout",
    if(file.hasTag("Fish/Goldfish"), "Goldfish",
    if(file.hasTag("Fish/Catfish"), "Catfish",
    "Other / none stated")))))))
  study_type: |
    if(file.hasTag("Type/Experiment"), "Experiment",
    if(file.hasTag("Type/Quasi-experiment"), "Quasi-experiment",
    if(file.hasTag("Type/Narrative-Review"), "Narrative Review",
    if(file.hasTag("Type/Systematic-Review"), "Systematic Review",
    if(file.hasTag("Type/Meta-analysis"), "Meta-analysis",
    if(file.hasTag("Type/Modelling"), "Modelling",
    if(file.hasTag("Type/Exploratory"), "Exploratory",
    if(file.hasTag("Type/Observational"), "Observational",
    if(file.hasTag("Type/Case-Study"), "Case Study",
    if(file.hasTag("Type/Technical-Note"), "Technical Note",
    if(file.hasTag("Type/Field-trial"), "Field Trial",
    if(file.hasTag("Type/Policy"), "Policy",
    if(file.hasTag("Type/Methods"), "Methods", "Review"))))))))))))
properties:
  title:
    displayName: Title
  note.year:
    displayName: Year
  formula.main_plant:
    displayName: Plant
  formula.main_fish:
    displayName: Fish
  formula.study_type:
    displayName: Study Type
  note.status:
    displayName: Status
  note.quality:
    displayName: Quality
  note.trials:
    displayName: Trials
views:
  - type: table
    name: All Papers
    groupBy:
      property: formula.main_plant
      direction: ASC
    order:
      - title
      - note.year
      - formula.main_plant
      - formula.main_fish
      - formula.study_type
      - note.quality
      - note.trials
    sort:
      - property: formula.main_plant
        direction: ASC
      - property: note.year
        direction: DESC
  - type: board
    name: By Plant
    groupBy:
      property: formula.main_plant
      direction: ASC
    order:
      - title
      - note.year
      - formula.study_type
  - type: board
    name: By Fish
    groupBy:
      property: formula.main_fish
      direction: ASC
    order:
      - title
      - note.year
      - formula.main_plant
  - type: cards
    name: Cards
    order:
      - title
      - note.year
      - formula.main_plant
      - formula.main_fish
    limit: 60
